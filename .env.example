# Create .env from this file; never commit the real values.
# Create a bot via @BotFather. Start a private chat with it, then use /whoami
BOT_TOKEN=replace_me

# Telegram user API credentials from https://my.telegram.org/apps.
# They are only required to watch Telegram channels through Telethon.
TG_API_ID=
TG_API_HASH=
TG_PHONE=

# Your numeric Telegram user ID. Send /whoami to the bot to discover it.
OWNER_CHAT_ID=

# Comma-separated list of public channels, with or without @.
TELEGRAM_CHANNELS=example_channel

# Polling interval for RSS and HTML sources, in minutes.
POLL_INTERVAL_MINUTES=10

# Per-cycle maximum; helps prevent message floods.
MAX_ITEMS_PER_CYCLE=10

# Optional proxy URL, e.g. socks5://user:password@host:1080
PROXY_URL=
