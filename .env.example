# Создайте .env из этого файла и никогда не коммитьте настоящие значения.
# Создайте бота через @BotFather, начните с ним личный чат и выполните /whoami.
BOT_TOKEN=replace_me

# Учётные данные Telegram API из https://my.telegram.org/apps.
# Они нужны только для наблюдения за каналами через Telethon.
TG_API_ID=
TG_API_HASH=
TG_PHONE=

# Ваш числовой Telegram ID. Узнайте его командой /whoami у бота.
OWNER_CHAT_ID=

# Список публичных каналов через запятую, с @ или без него.
TELEGRAM_CHANNELS=example_channel

# Интервал опроса RSS- и HTML-источников в минутах.
POLL_INTERVAL_MINUTES=10

# Максимум новостей за один цикл: защищает от потока сообщений.
MAX_ITEMS_PER_CYCLE=10

# Необязательный URL прокси, например socks5://user:password@host:1080
PROXY_URL=
